# Auth.js (NextAuth v5) — required in production
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000

# PostgreSQL (Supabase EU pooler URI, or local docker-compose)
# Example local: postgres://family:family@localhost:5432/family_events
# Example Supabase: postgres://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://family:family@localhost:5432/family_events

# Optional: override the seeded admin password (default is documented in README)
# SEED_ADMIN_PASSWORD=FamilyEvents!2026

# Supabase Storage (event cover images). Service role is server-only — never expose to the client.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_URL is accepted as an alias for the project URL.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
